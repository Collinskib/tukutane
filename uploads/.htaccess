# Uploaded files are served as static content only — no script execution.
Options -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

# Filenames are random per upload, so content at a URL never changes —
# safe to cache forever (this also covers generated thumbs/).
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(jpe?g|png|webp|gif|pdf|txt|csv|docx?|xlsx?|pptx?|zip)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
