{
  "expo": {
    "name": "Nipange",
    "slug": "nipange",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.nipange"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faf8f2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "package": "ke.co.nipange",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#163e31"
        }
      ],
      "expo-secure-store",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.101117355999-qdhmag4bi9na6vfqr7ko3rjrcpn5i0ph"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f2"
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "scheme": "nipange",
    "extra": {
      "googleWebClientId": "101117355999-s0ftf8kh122732didonknm2mscmpem0j.apps.googleusercontent.com",
      "googleAndroidClientId": "101117355999-u87iq0f6nbnenintcqfgvt49m3446ltk.apps.googleusercontent.com",
      "googleIosClientId": "101117355999-qdhmag4bi9na6vfqr7ko3rjrcpn5i0ph.apps.googleusercontent.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "039fe77e-90a7-4f3b-a684-83f2df0ccd01"
      }
    }
  }
}